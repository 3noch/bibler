# Workers Static Assets response headers (copied into build/cloudflare/assets by `make cloudflare-assets`).
# Content-hashed files never change; everything else (index.html, sw.js, the list of texts, text manifests) is
# revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/text/:text/*
  Cache-Control: public, max-age=31536000, immutable
/text/:text/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
/text/texts.json
  Cache-Control: no-cache
