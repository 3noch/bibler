# Workers Static Assets response headers (copied into build/cloudflare/assets by `make cloudflare-assets`).
# Content-hashed files never change; everything else (index.html, sw.js, text manifests) is revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/text/:text/*
  Cache-Control: public, max-age=31536000, immutable
/text/:text/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
